DISCORD_TOKEN=
YT_DLP_PATH=/home/lonelyslack/bin/yt-dlp
FFMPEG_PATH=/home/lonelyslack/bin/ffmpeg
PREFIX=lofi

# Route yt-dlp through Cloudflare WARP's SOCKS proxy (same as the music bot).
# Set to an empty value to go direct.
YT_DLP_PROXY=socks5://127.0.0.1:40000

# Station played when a guild hasn't picked one, and the station we fall back to
# when the primary keeps failing. Use ids from `lofi stations`.
DEFAULT_STATION=lofigirl
FALLBACK_STATION=somafm-fluid

# Recycle the ffmpeg/yt-dlp chain every N hours as hygiene against slow leaks and
# stale CDN sessions (brief ~1s gap). 0 disables.
STREAM_RECYCLE_HOURS=12

# Register slash commands to this guild only (instant). Leave empty for global
# registration, which can take up to an hour to appear.
GUILD_ID=

# Discord user IDs allowed to run `lofi admin`. Comma-separated.
ADMIN_ID=
